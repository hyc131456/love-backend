# Loopback port used by the host OpenResty reverse proxy.
FRONTEND_PORT=18080

# Use "latest" for normal deployment, or a commit SHA tag for rollback.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
DATABASE_IMAGE_TAG=latest

# Change all secrets before deploying to a public server.
MYSQL_USER=love_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional: required only for real WeChat login.
WECHAT_APPID=
WECHAT_SECRET=
