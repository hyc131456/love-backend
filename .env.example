# Public HTTP port for the H5 application.
APP_PORT=8080

# Change all secrets before deploying to a public server.
MYSQL_USER=love_app
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional: required only for real WeChat login.
WECHAT_APPID=
WECHAT_SECRET=
